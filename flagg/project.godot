rendering_device/driver.windows="d3d12"
shading/overrides/force_vertex_shading=true
textures/decals/filter=2
textures/light_projectors/filter=2

[shader_globals]

resolution={
"type": "ivec2",
"value": Vector2i(640, 480)
}
