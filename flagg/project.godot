; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="monsterhunter"
run/main_scene="uid://bs2dbfush45pt"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=30
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://bt0mvmdks38jl"

[autoload]

Global="*uid://bc1b0sp5csjmr"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/resizable=false
window/size/borderless=true
window/size/sharp_corners=true
window/size/minimize_disabled=true
window/size/maximize_disabled=true
window/size/window_width_override=960
window/size/window_height_override=720
window/stretch/mode="viewport"

[file_customization]

folder_colors={
"res://classes/goose/": "green",
"res://classes/zombie/": "red",
"res://objects/portal/": "purple",
"res://scenes/forest/": "orange"
}

[global_group]

ladder=""
enemy=""

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"compress/normal_map": 0,
"compress/rdo_quality_loss": 0.0,
"compress/uastc_level": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"process/channel_remap/alpha": 3,
"process/channel_remap/blue": 2,
"process/channel_remap/green": 1,
"process/channel_remap/red": 0,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

